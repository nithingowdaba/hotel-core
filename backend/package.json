{
  "name": "hotel-core",
  "version": "1.0.0",
  "description": "Multi-tenant food ordering platform backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --test-concurrency=1",
    "verify": "npm test && find .. -type d \\( -path '*/node_modules' -o -path '*/.git' \\) -prune -o -type f -name '*.js' -print0 | xargs -0 -r -n1 node --check && git diff --check && git diff --cached --check",
    "create-platform-admin": "node scripts/create-platform-admin.js",
    "db:init": "node scripts/init-db.js",
    "db:seed": "node scripts/seed-db.js",
    "db:reset": "node scripts/reset-db.js",
    "migrate": "node scripts/migrate.js",
    "db:schema": "node scripts/db-schema.js",
    "db:explain": "node scripts/explain.js",
    "seed": "node scripts/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
